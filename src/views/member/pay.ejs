<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <div class="shell">
    <%- include('../partials/sidebar') %>
    <main class="content">
      <h1>Complete payment</h1>

      <% if (error) { %>
        <div class="alert"><%= error %></div>
        <div class="page-actions">
          <a class="btn btn-ghost" href="/member/registrations">Back</a>
        </div>
      <% } else if (order) { %>
        <div class="form-panel form-wide stack">
          <p><strong><%= order.eventTitle %></strong></p>
          <p>Amount: ₹<%= (order.amountPaise / 100).toFixed(2) %></p>
          <button id="payBtn" class="btn btn-primary" type="button">Pay with Razorpay</button>
          <a class="btn btn-ghost" href="/member/registrations">Cancel</a>
        </div>

        <form id="verifyForm" method="POST" action="/member/registrations/<%= order.registrationId %>/verify" style="display:none;">
          <input type="hidden" name="razorpay_order_id" id="razorpay_order_id" />
          <input type="hidden" name="razorpay_payment_id" id="razorpay_payment_id" />
          <input type="hidden" name="razorpay_signature" id="razorpay_signature" />
        </form>

        <script>
          document.getElementById('payBtn').addEventListener('click', function () {
            const options = {
              key: '<%= order.keyId %>',
              amount: <%= order.amountPaise %>,
              currency: 'INR',
              name: 'Eventra',
              description: <%- JSON.stringify(order.eventTitle) %>,
              order_id: '<%= order.orderId %>',
              handler: function (response) {
                document.getElementById('razorpay_order_id').value = response.razorpay_order_id;
                document.getElementById('razorpay_payment_id').value = response.razorpay_payment_id;
                document.getElementById('razorpay_signature').value = response.razorpay_signature;
                document.getElementById('verifyForm').submit();
              }
            };
            const rzp = new Razorpay(options);
            rzp.open();
          });
        </script>
      <% } %>
    </main>
  </div>
</body>
</html>