<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <div class="shell">
    <%- include('../partials/sidebar') %>
    <main class="content" data-gallery>
      <div class="page-header">
        <div>
          <h1>Events</h1>
          <p class="muted">Discover and register for upcoming club events.</p>
        </div>
      </div>

      <% if (!events.length) { %>
        <p class="muted">No published events right now.</p>
      <% } else { %>
        <div class="gallery-toolbar">
          <div class="gallery-tabs">
            <button type="button" class="gallery-tab is-active" data-gallery-tab="all">All Events</button>
            <button type="button" class="gallery-tab" data-gallery-tab="registered">Registered</button>
            <button type="button" class="gallery-tab" data-gallery-tab="past">Past</button>
          </div>
          <div class="page-tools">
            <input type="search" data-gallery-search placeholder="Search events..." />
            <select data-gallery-status>
              <option value="">All status</option>
              <option value="PUBLISHED">Published</option>
              <option value="COMPLETED">Completed</option>
            </select>
          </div>
        </div>
        <div class="gallery-grid">
          <% events.forEach((event) => { %>
            <%- include('../partials/event-gallery-card', { event: event, role: 'member' }) %>
          <% }) %>
        </div>
        <p class="muted" data-gallery-empty hidden>No events match this filter.</p>
      <% } %>
    </main>
  </div>
</body>
</html>
