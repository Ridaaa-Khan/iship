<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <div class="shell">
    <%- include('../partials/sidebar') %>
    <main class="content">
      <div class="dash-header">
        <div>
          <h1>Welcome, <span class="accent-name"><%= dashboard.greetingName || 'Member' %></span></h1>
          <p class="muted"><%= dashboard.subtitle %></p>
        </div>
        <div class="dash-date"><%= dashboard.todayLabel %></div>
      </div>

      <section class="stat-grid">
        <article class="stat-card stat-blue">
          <div class="stat-icon">👤</div>
          <div class="stat-label">Total visits</div>
          <div class="stat-value"><%= dashboard.stats.totalVisits %></div>
          <div class="stat-sub">Since joining</div>
        </article>
        <article class="stat-card stat-amber">
          <div class="stat-icon">◷</div>
          <div class="stat-label">Last scanned</div>
          <div class="stat-value stat-value-sm">
            <%= dashboard.stats.lastScan ? formatDate(dashboard.stats.lastScan.created_at) : '—' %>
          </div>
          <div class="stat-sub">
            <% if (dashboard.stats.lastScan) { %>
              <%= dashboard.stats.lastScan.device_label || dashboard.stats.lastScan.event_title %>
            <% } else { %>
              No scans yet
            <% } %>
          </div>
        </article>
        <article class="stat-card stat-green">
          <div class="stat-icon">▤</div>
          <div class="stat-label">This month's visits</div>
          <div class="stat-value"><%= dashboard.stats.monthVisits %></div>
          <div class="stat-sub"><%= dashboard.stats.monthRange %></div>
        </article>
      </section>

      <section class="member-dash-grid">
        <div class="member-dash-main">
          <article class="dash-panel">
            <div class="dash-panel-head">
              <div>
                <h2>Recent activity</h2>
                <p class="muted">Your latest entry and exit scans.</p>
              </div>
              <a class="panel-link" href="/member/registrations">View all →</a>
            </div>
            <% if (!dashboard.recent.length) { %>
              <p class="muted">No activity yet.</p>
            <% } else { %>
              <div class="activity-list">
                <% dashboard.recent.slice(0, 5).forEach((row) => { %>
                  <div class="activity-row">
                    <div class="activity-main">
                      <span class="activity-icon" aria-hidden="true">→</span>
                      <div>
                        <strong>Entry scanned</strong>
                        <div class="muted"><%= row.device_label || row.event_title %></div>
                      </div>
                    </div>
                    <div class="muted"><%= formatDate(row.created_at) %></div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </article>

          <article class="explore-banner">
            <div>
              <h2>Explore events</h2>
              <p>Discover upcoming events, workshops and club activities and register now.</p>
              <a class="btn btn-primary" href="/member/events">Browse Events →</a>
            </div>
            <div class="explore-art" aria-hidden="true">📅</div>
          </article>
        </div>

        <article class="dash-panel">
          <div class="dash-panel-head">
            <div>
              <h2>Your upcoming events</h2>
              <p class="muted">Events you can register for.</p>
            </div>
            <a class="panel-link" href="/member/events">View all →</a>
          </div>
          <% var upcomingCards = dashboard.openEvents && dashboard.openEvents.length ? dashboard.openEvents : dashboard.upcoming; %>
          <% if (!upcomingCards.length) { %>
            <p class="muted">No upcoming events.</p>
          <% } else { %>
            <div class="upcoming-list">
              <% upcomingCards.forEach((row) => { %>
                <% var parts = eventDateParts(row.starts_at); %>
                <% var eventId = row.event_id || row.id; %>
                <% var canRegister = !row.status || row.status === 'PUBLISHED'; %>
                <div class="upcoming-item">
                  <div class="date-badge">
                    <span><%= parts.month %></span>
                    <strong><%= parts.day %></strong>
                  </div>
                  <div class="upcoming-copy">
                    <h3><%= row.title %></h3>
                    <p>
                      <%= row.starts_at ? formatDate(row.starts_at) : '' %>
                      <% if (row.venue) { %> · <%= row.venue %><% } %>
                    </p>
                    <% if (row.seatsLeft != null) { %>
                      <p class="muted"><%= row.seatsLeft %> seats left</p>
                    <% } %>
                  </div>
                  <% if (canRegister && row.seatsLeft != null) { %>
                    <a class="btn btn-primary btn-sm" href="/member/events/<%= eventId %>">Register</a>
                  <% } else { %>
                    <a class="btn btn-ghost btn-sm" href="/member/events/<%= eventId %>">View</a>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } %>
        </article>
      </section>
    </main>
  </div>
</body>
</html>
