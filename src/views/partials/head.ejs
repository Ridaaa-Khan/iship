<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= title %> · iShip</title>
<link rel="stylesheet" href="/css/main.css" />
<script src="/js/table-filter.js" defer></script>
<script src="/js/form-fields.js" defer></script>
</head>
<body<% if (!currentUser) { %> class="auth-body"<% } %>>
<% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <header class="topbar">
    <div class="brand">iShip</div>
    <div class="topbar-right">
      <span class="role-chip role-<%= String(currentUser.role).toLowerCase() %>"><%= currentUser.role %></span>
      <span class="user-name"><%= currentUser.displayName || currentUser.email %></span>
    </div>
  </header>
<% } %>
